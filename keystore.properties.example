# Copy this file to "keystore.properties" (same folder) and fill in your values.
# keystore.properties is git-ignored — never commit it or the .jks file.
#
# storeFile is resolved relative to the repo root. Point it at the keystore you
# created with keytool (you can keep the .jks outside the repo and use an absolute
# path, e.g. /Users/you/spike-upload-key.jks).

storeFile=spike-upload-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=spike-upload
keyPassword=YOUR_KEY_PASSWORD
